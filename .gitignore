# --- Môi trường ảo (Virtual Environments) ---
venv/
.venv/
env/

# --- File cấu hình bảo mật (CỰC KỲ QUAN TRỌNG) ---
.env

# --- Thư mục chứa Database & Data của dự án ---
# Không đưa Vector DB lên Git vì nó rất nặng và sinh ra liên tục
chroma_db/
# Không đưa sách PDF gốc lên Git (tránh vi phạm bản quyền và nặng kho lưu trữ)
data_sach/*.pdf

# --- File tạm thời sinh ra trong quá trình chạy (API Upload File) ---
temp_*

# --- Python Cache ---
__pycache__/
*.py[cod]
*$py.class

# --- OS & IDE (Hệ điều hành & Trình soạn thảo) ---
.DS_Store
.vscode/
.idea/

*.env
*.pdf
*.bin
*.sqlite3
*.jon
*.pyc
*.ipynb
questions.txt
artisans_data.csv

# --- Node.js / Next.js ---
node_modules/
.next/
out/
*.tsbuildinfo

# --- Local heavy media assets ---
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.aiff
*.flac

# Local source media folder
public/audio/*.mp4
public/audio/*.mov
public/audio/*.wav
public/audio/*.aiff
public/audio/*.flac

# Keep lightweight compressed audio allowed if needed
!public/audio/*.mp3
!public/audio/*.ogg

# Local raw art/audio assets
/assets/raw/
/media/raw/

